{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "react": ["./src/shims/react.ts"],
      "react/jsx-runtime": ["./src/shims/jsx-runtime.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
